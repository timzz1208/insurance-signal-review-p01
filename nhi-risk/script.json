{
  "title_zh": "健保破兆，為什麼你還是要準備醫療費",
  "fps": 30,
  "scenes": [
    { "id": "cover", "lead": 0.35, "gap": 0.3, "tail": 0.7, "lines": [
      { "zh": "明年健保總額，首度突破一兆元。" },
      { "zh": "為什麼你還是可能要自己準備醫療費？" }
    ]},
    { "id": "myth", "lead": 0.35, "gap": 0.3, "tail": 1.0, "lines": [
      { "zh": "健保有錢，不等於你的醫療全部免費。" },
      { "zh": "公共支出往上長，個人自費卻一直都在。" }
    ]},
    { "id": "costs", "lead": 0.35, "gap": 0.3, "tail": 1.1, "lines": [
      { "zh": "新藥還沒納入健保前，可能要自費。" },
      { "zh": "特殊醫材要付差額，單人病房要補差價。" },
      { "zh": "生病沒辦法工作，收入也可能中斷。" },
      { "zh": "真正落到家庭身上的，不只有醫藥費。" }
    ]},
    { "id": "umbrella", "lead": 1.4, "gap": 0.9, "tail": 2.6, "lines": [
      { "zh": "健保處理的，是社會一起扛的風險。" },
      { "zh": "個人保障處理的，是掉到你家裡的那一塊。" }
    ]},
    { "id": "close", "lead": 0.4, "gap": 0.35, "tail": 3.2, "lines": [
      { "zh": "健保越完整，不代表商業保險就不重要。" },
      { "zh": "而是要搞清楚：哪些有人幫你扛，哪些沒有。" },
      { "zh": "下次看保單，先別問保多少，先問：這筆風險最後誰付？" }
    ]}
  ]
}
